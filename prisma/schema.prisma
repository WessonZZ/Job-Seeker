// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────
// 板块 1 & 2: 行业 · 公司 · 岗位
// ─────────────────────────────

model Industry {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  companies   Company[]
}

model Company {
  id          String       @id @default(cuid())
  industryId  String
  industry    Industry     @relation(fields: [industryId], references: [id])
  name        String
  slug        String
  website     String?
  description String?
  logo        String?
  createdAt   DateTime     @default(now())
  jobPostings JobPosting[]

  @@unique([industryId, slug])
}

model JobPosting {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  title      String
  jd         String
  url        String?
  source     String?
  salary     String?
  location   String?
  tags       String?
  postedDate DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  applications Application[]
}

// ─────────────────────────────
// 板块 3: 用户 · 经历 · 投递 · 时间线
// ─────────────────────────────

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?
  phone           String?
  avatar          String?
  school          String?
  major           String?
  degree          String?
  graduationYear  Int?
  summary            String?
  resumeUrl          String?
  createdAt          DateTime         @default(now())
  workExperiences    WorkExperience[]
  projectExperiences ProjectExperience[]
  applications       Application[]
}

model WorkExperience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ProjectExperience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  projectName String
  role        String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Application {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  jobPostingId  String?
  jobPosting    JobPosting?     @relation(fields: [jobPostingId], references: [id])

  companyName   String
  position      String
  jd            String?
  url           String?
  appliedDate   DateTime
  status        String          @default("applied")
  notes         String?
  priority      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  timelineEvents TimelineEvent[]
}

model TimelineEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType     String
  title         String
  description   String?
  date          DateTime
  isKey         Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// 应用级键值设置（如 LLM 配置），运行时读写，无需改环境变量
model Setting {
  key   String @id
  value String
}
